# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# ── Required ────────────────────────────────────────────────────────────────────

# 64-character hex string (32 bytes) for AES-256-GCM device password encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET_KEY=

# ── Server ──────────────────────────────────────────────────────────────────────

# PORT=3001
# NODE_ENV=production
# LOG_LEVEL=info

# ── Authentication ──────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens. Change this in production.
# JWT_SECRET=change-me-in-production
# BCRYPT_ROUNDS=12

# ── RTMP Relay ──────────────────────────────────────────────────────────────────

# Port for the local RTMP relay (node-media-server). OBS streams to this port.
# RELAY_PORT=1935

# ── YouTube Streaming (optional) ────────────────────────────────────────────────

# Obtain from Google Cloud Console → Credentials → OAuth 2.0 Client ID
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# ── Facebook Streaming (optional) ───────────────────────────────────────────────

# Obtain from Facebook Developer Portal → App Settings → Basic
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ── OAuth Callback ──────────────────────────────────────────────────────────────

# Base URL for OAuth redirect callbacks. Defaults to https://localhost.
# Set to your public domain if available (e.g., https://av.yourchurch.org).
# APP_URL=https://localhost

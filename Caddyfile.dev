# Development Caddyfile — proxies to Vite dev server + Express backend.
# Usage: sudo caddy start --config Caddyfile.dev
#
# Prerequisites:
#   bash scripts/generate-cert.sh   # one-time cert generation

# Bound graceful shutdown. Without this, `caddy stop` / restart blocks indefinitely
# while browsers hold keep-alive or websocket connections, which leaves the old
# process half-alive holding the admin port (2019) and wedges the dev->prod switch.
{
	grace_period 5s
}

# Shared routing for every HTTPS hostname above.
(app_routes) {
	@backend path /api/* /socket.io/* /preview/*
	handle @backend {
		reverse_proxy localhost:3001
	}

	handle {
		reverse_proxy localhost:5173
	}
}

invisible.av, localhost {
	tls certs/localhost.crt certs/localhost.key
	import app_routes
}

# Remote access over Tailscale (https://bmbc-optiplex-7000.tail7f999c.ts.net).
# No `tls` directive on purpose: for *.ts.net names Caddy fetches a publicly
# trusted certificate from the local tailscaled, so devices need no manual cert
# import. Requires "HTTPS Certificates" enabled in the Tailscale admin console
# (DNS tab) and Caddy permitted to talk to tailscaled (run as root, or
# `sudo tailscale set --operator=$USER`). See docs/setup.md.
bmbc-optiplex-7000.tail7f999c.ts.net {
	import app_routes
}

# HTTP-only overlay endpoint for OBS browser sources.
# OBS's embedded Chromium (CEF) cannot easily trust self-signed certs,
# so the overlay is served over plain HTTP. This is safe because:
#   - The overlay namespace is unauthenticated
#   - It only runs locally inside OBS on the same machine
#   - No sensitive data is transmitted
:3080 {
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy localhost:3001
	}

	handle {
		reverse_proxy localhost:5173
	}
}

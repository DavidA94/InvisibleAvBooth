# Production Caddyfile — serves static frontend + proxies to Express backend.
# Usage: sudo caddy start --config Caddyfile
#
# Prerequisites:
#   bash scripts/generate-cert.sh   # one-time cert generation
#   npm run build                   # build frontend

invisible.av, localhost {
	tls certs/localhost.crt certs/localhost.key

	@backend path /api/* /socket.io/* /preview/*
	handle @backend {
		reverse_proxy localhost:3001
	}

	handle {
		root * packages/frontend/dist
		try_files {path} /index.html
		file_server
	}
}

# HTTP-only overlay endpoint for OBS browser sources.
# OBS's embedded Chromium (CEF) cannot easily trust self-signed certs,
# so the overlay is served over plain HTTP. This is safe because:
#   - The overlay namespace is unauthenticated
#   - It only runs locally inside OBS on the same machine
#   - No sensitive data is transmitted
:3080 {
	@backend path /api/* /socket.io/*
	handle @backend {
		reverse_proxy localhost:3001
	}

	handle {
		root * packages/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
